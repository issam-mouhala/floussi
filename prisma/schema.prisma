generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth (Task 21) ─────────────────────────────────────────────────────────
//
// Floussi is multi-user since the auth upgrade: every piece of user-owned
// data carries a required `userId` FK. Categories are per-user too (the 13
// base categories are cloned at signup, and the smart-darija engine only
// ever creates categories inside the current user's space).
// Sessions: opaque random token in an HttpOnly cookie, SHA-256 hash stored
// server-side, 30-day sliding expiry.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  createdAt     DateTime  @default(now())
  sessions      Session[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  goals         SavingGoal[]
  notifications AppNotification[]
  settings      Settings?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id           String   @id @default(cuid())
  slug         String
  nameEn       String
  nameFr       String
  nameAr       String
  // native Darija display name (Arabic script) — auto-generated by the smart
  // darija engine for custom categories, user-overridable. null = use nameAr.
  nameAry      String?
  icon         String   @default("Wallet")
  color        String   @default("#10b981")
  essential    Boolean  @default(false)
  sortOrder    Int      @default(0)
  transactions Transaction[]
  budgets      Budget[]
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model Transaction {
  id            String    @id @default(cuid())
  amount        Float
  note          String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date          DateTime  @default(now())
  // null = inherit category.essential
  necessary     Boolean?
  // precise per-expense icon from smart detection (null = use category icon)
  icon          String?
  isRecurring   Boolean   @default(false)
  paymentMethod String    @default("cash")
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@index([userId, date])
}

model Budget {
  id         String    @id @default(cuid())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  period     String    @default("monthly")
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

model SavingGoal {
  id            String    @id @default(cuid())
  title         String
  emoji         String    @default("🎯")
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppNotification {
  id        String   @id @default(cuid())
  type      String // daily_budget | above_avg | category_spike | save_track | small_purchases | weekend | insight
  level     String   @default("info") // info | success | warning | danger
  key       String // i18n template key
  payload   String   @default("{}") // JSON params for the template
  dedupeKey String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId])
}

model Settings {
  id            String   @id @default(cuid())
  displayName   String   @default("Yassine")
  language      String   @default("en") // en | fr | ary
  currency      String   @default("MAD")
  theme         String   @default("system")
  monthlyBudget Float    @default(6000)
  dailyBudget   Float    @default(200)
  weekendBudget Float    @default(350)
  savingsTarget Float    @default(600)
  updatedAt     DateTime @updatedAt
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
